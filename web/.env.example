NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key

# Optional: include Mapbox route alternatives alongside backend SafePath routes.
NEXT_PUBLIC_ENABLE_MAPBOX_ROUTES=true

# Optional: ask the backend for more safety-weighted route variants.
NEXT_PUBLIC_EXTRA_SAFETY_LAMBDAS=1.5,3.0
